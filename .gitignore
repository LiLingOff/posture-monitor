__pycache__/
*.pyc
.pytest_cache/
.venv/

data/calibration_images/*/*.png
data/calibration_images/*/*.jpg
data/calibration_output/*.npz

data/pose_models/*.pth
data/pose_models/*.json

# clone 下來的 Lightweight OpenPose（沒有 setup.py，只能放路徑上）
third_party/

# 逐幀記錄、快照與個人基準。快照是左眼原始畫面，裡面有受試者的臉，
# 而這個 repo 是 public；從 Jetson 拷回來的檔案不能跟著進版控。
data/sessions/
# 順序分組的登記檔，裡面是受試者代號，不進 public repo。
data/order_groups.csv
data/kinovea/
data/baselines/
# run-plan 當場作廢的段落搬到 <out-dir>-discarded/，同樣有受試者的臉。
data/sessions-discarded/
*-discarded/

# 外部評分者盲評（rating-pack／ratings）。盲評包有受試者的臉，key 檔對得回受試者
# 與系統判定，評分表是評分者的資料，三者都不能進這個 public repo。
# 預設放 data/rating_packs/ 與 data/ratings/。盲評包與 key 的資料夾裡各自另有
# 一個忽略全部的 .gitignore，放到別處也不會被收進來。
data/rating_packs/
data/ratings/
key.csv
rating_sheet*.csv
rating_segments.csv

# 尺度檢查用的左右眼原始畫面（data/check620 等）。畫面裡拍得到人臉，
# 而這個 repo 是 public，不能進版控。
data/check*/

# run-plan 的畫面紀錄（script 錄下來給遠端旁觀），含受試者代號，不進 public repo。
data/logs/
data/csv-from-mina/
data/sessions-from-mina/
